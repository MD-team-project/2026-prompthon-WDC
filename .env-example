# Copy to .env and fill in. .env is gitignored and must never be committed.
# Variable names here are the environment contract INFRA publishes; BE reads them
# in packages/backend/src/config.ts.

# --- AWS ---

# AWS CLI profile. LOCAL EXECUTION ONLY.
# On EC2 the backend uses the instance role, never a profile or an access key.
# Set up locally with: aws configure set aws_access_key_id ... --profile prompthon
AWS_PROFILE=prompthon

# The account denies the services this project needs outside us-east-1.
AWS_REGION=us-east-1

# Single DynamoDB table. Partition key `id` (String), no sort key, no index.
# Matches packages/backend/src/data/skills.ts. Accepts a table name or a full ARN.
# Real deployed value (construction/infra PR #6, account 643922457910):
# prompthon-runtime-AppTable815C50BC-1O831W9BLPJNG
DDB_TABLE_NAME=

# Bedrock model for the agent's control path. Configurable on purpose: reverting
# to a faster model is a config flip, not a code change.
# Fallbacks and the mandatory us./global. prefix: see infra/README.md.
BEDROCK_MODEL_ID=us.anthropic.claude-opus-4-6-v1

# --- Friendli / K-EXAONE ---

# Secret. Local development only - paste the real value into .env.
# Never commit it, log it, print it, or put it in CDK context or user data.
FRIENDLI_API_KEY=

# Hosted execution reads the key from this SecureString instead of .env.
# The parameter NAME is not a secret. See infra/README.md.
FRIENDLI_API_KEY_SSM_PARAMETER=/prompthon/friendli-api-key

# Dedicated endpoint id, passed as the model name. NOT a secret, but REQUIRED -
# the backend throws at boot without it.
FRIENDLI_ENDPOINT_ID=

# Override only if Friendli moves the dedicated endpoint.
FRIENDLI_BASE_URL=https://api.friendli.ai/dedicated/v1

# --- Application ---

# Backend HTTP port. This is the port a security group rule would expose if the
# app is ever deployed publicly, and only after the NFR-5.2 passcode gate exists.
PORT=3000

# device-stub, run locally alongside the backend.
DEVICE_API_URL=http://localhost:4000
