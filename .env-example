# AWS CLI profile used for this project instead of "default".
# Set it up locally with: aws configure set aws_access_key_id ... --profile <your-profile-name>
# (or paste AWS Workshop Studio's provided credentials under a profile of your choice)
# Then copy this file to .env and fill in the profile name you used, e.g. AWS_PROFILE=prompthon
AWS_PROFILE=

# DynamoDB table for discovered skills. Accepts either a table name or a full
# ARN - BE's data-access code (packages/backend/src/data/skills.ts) is ready
# for either, no code change needed once INFRA provisions the table.
DDB_TABLE_NAME=
