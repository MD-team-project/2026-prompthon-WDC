# Copy to .env and fill in. .env is gitignored and must never be committed.

# AWS CLI profile used for this project instead of "default". Local execution only.
# Hosted execution on EC2 uses the instance role, never a profile or access key.
# Set up locally with: aws configure set aws_access_key_id ... --profile prompthon
AWS_PROFILE=prompthon

# The account denies the services this project needs outside us-east-1.
AWS_REGION=us-east-1

# Bedrock model for Agentic Control. Configurable on purpose: reverting to a
# faster model is a config flip, not a code change.
# Fallbacks and the mandatory us./global. prefix: see infra/README.md.
BEDROCK_MODEL_ID=us.anthropic.claude-opus-4-6-v1

# Friendli (EXAONE) key. Local development only - paste the real value into .env.
# Never commit it, log it, print it, or put it in CDK context or user data.
FRIENDLI_API_KEY=

# Hosted execution reads the key from this SecureString instead of .env - see infra/README.md.
FRIENDLI_API_KEY_SSM_PARAMETER=/prompthon/friendli-api-key
